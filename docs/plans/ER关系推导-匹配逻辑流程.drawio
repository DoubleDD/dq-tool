  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="2100" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="ER 关系推导 · 匹配逻辑流程" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Times New Roman,SimSun;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="280" y="16" width="320" height="32" as="geometry"/></mxCell><mxCell id="3" value="选定锚点表 + 锚点字段&lt;br&gt;(业务专家手选候选关联键)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="272" y="80" width="336" height="64" as="geometry"/></mxCell><mxCell id="4" value="通道一:字段名精准匹配&lt;br&gt;忽略大小写,查全库字段清单&lt;br&gt;(meta_schema_column 缓存)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="204" width="336" height="88" as="geometry"/></mxCell><mxCell id="5" value="启用语义匹配?&lt;br&gt;(需已配置大模型)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="556" y="200" width="264" height="96" as="geometry"/></mxCell><mxCell id="6" value="阶段一·表级粗筛&lt;br&gt;有 AI 表描述用描述&lt;br&gt;无描述回退表注释&lt;br&gt;LLM 分批筛出相关表" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="336" width="320" height="112" as="geometry"/></mxCell><mxCell id="7" value="阶段二·字段级精判&lt;br&gt;LLM 按字段名+注释&lt;br&gt;确定具体字段对应" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="492" width="320" height="88" as="geometry"/></mxCell><mxCell id="8" value="合并候选字段对&lt;br&gt;去重,跳过已否决对" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="296" y="636" width="288" height="72" as="geometry"/></mxCell><mxCell id="9" value="轻量值交集验证&lt;br&gt;两端各取 ≤1000 个 DISTINCT 值&lt;br&gt;求交集比例(置信度核心证据)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="764" width="400" height="88" as="geometry"/></mxCell><mxCell id="10" value="基数验证&lt;br&gt;唯一索引命中→直接定「一」侧&lt;br&gt;否则 GROUP BY HAVING COUNT&gt;1&lt;br&gt;(排除 NULL)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="260" y="892" width="360" height="104" as="geometry"/></mxCell><mxCell id="11" value="基数可取?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=13;fontFamily=Times New Roman,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="352" y="1052" width="176" height="88" as="geometry"/></mxCell><mxCell id="12" value="剔除&lt;br&gt;(空表/查询失败)" style="rounded=1;arcSi