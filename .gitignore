# Java / Gradle
build/
.gradle/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# Node / Vite
node_modules/
web/dist/

# Tauri(Rust 构建产物 / 打包脚本组装的内嵌资源 / 移动端生成物)
tauri/src-tauri/target/
tauri/src-tauri/resources/**
!tauri/src-tauri/resources/PLACEHOLDER.txt
tauri/src-tauri/gen/

# 运行时数据
data/
logs/
*.log

# desktop 打包下载的 JBR 运行时(大体积二进制,由构建脚本拉取)
desktop/runtime/

# 前端视觉走查的临时截图与脚本
web/.visual-check/

# 授权码签发私钥(分发方自行保管,勿提交)
license-private.key

# 系统文件
.DS_Store

# Office 打开文档时的临时锁文件
~$*.docx

# draw.io 编辑器临时目录
.drawio-tmp/

# 本地工具产物(pi 子代理/构建目录/reasonix 权限配置,勿提交)
.kotlin/
.pi-subagents/
.gradle-home*/
.reasonix/
reasonix.toml
