<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="com.example.dq" level="DEBUG"/>
    <!-- Jewel 0.39.1 在 macOS 反射窗口 peer 时对 LWCWindowPeer 调 getDeclaredMethod("getPlatformWindow"),
         而 JBR 25 该方法声明在父类 LWWindowPeer 上,必现 NoSuchMethodException(上游最新版仍如此);
         失败只跳过标题栏颜色同步,无功能影响,压到 ERROR 避免每次启动刷屏 -->
    <logger name="#MacPlatformServicesDefaultImpl" level="ERROR"/>
</configuration>
