<configuration>
    <!--
      运行日志输出到日志目录(数据目录同级的 logs/,如安装版 ~/.dq-tool/logs),按天滚动
      (dq-tool.yyyy-MM-dd.log),保留 30 天。
      dq.log-dir 由 main 在任何日志输出前设为系统属性(规则单点 StartupLog.logDirFor,
      -Ddq.log-dir 可显式覆盖);:- 后为开发模式默认值 ./logs(仓库根,已 gitignore)。
      logback 无 relaxed binding,变量名必须是 dq.log-dir。
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%thread] %logger{36} : %m%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${dq.log-dir:-./logs}/dq-tool.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${dq.log-dir:-./logs}/dq-tool.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>  <!-- 单文件上限,正常一天一个,%i 仅作超限兜底 -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%thread] %logger{36} : %m%n</pattern>
        </encoder>
    </appender>
    <!-- 第三方框架(Hikari/Flyway/Jetty 等)只留 WARN 及以上;本项目日志全部打印 -->
    <logger name="com.example.dq" level="INFO"/>
    <!-- 业务库 SQL 日志(DataSourceService 出口代理统一打印):排查慢 SQL/深分页等场景用;
         需关闭时改此行为 WARN/OFF 或 INFO 保留(默认即打印) -->
    <logger name="com.example.dq.sql" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
